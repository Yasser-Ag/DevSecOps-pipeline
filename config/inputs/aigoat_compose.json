{
  "name": "dse-aigoat-20261012",
  "networks": {
    "isolated": {
      "internal": true,
      "name": "dse-aigoat-20261012-isolated"
    }
  },
  "services": {
    "backend": {
      "container_name": "dse-aigoat-20261012-backend",
      "cpus": 2,
      "depends_on": {
        "ollama": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "ANONYMIZED_TELEMETRY": "False",
        "CONFIG_PATH": "/app/config/config.yml",
        "HF_HUB_OFFLINE": "1",
        "MKL_NUM_THREADS": "2",
        "OLLAMA_BASE_URL": "http://ollama:11434",
        "OMP_NUM_THREADS": "2",
        "TOKENIZERS_PARALLELISM": "false",
        "TRANSFORMERS_OFFLINE": "1"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 30,
        "start_period": "30s",
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request;urllib.request.urlopen('http://localhost:8000/api/products/')"
        ],
        "timeout": "5s"
      },
      "image": "devsecops-electronics/aigoat-backend:20261012-01",
      "labels": {
        "org.study.project": "devsecops-electronics",
        "org.study.role": "qualification",
        "org.study.target": "aigoat"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "3g",
      "memswap_limit": "3g",
      "networks": [
        "isolated"
      ],
      "pids_limit": 256,
      "restart": "no",
      "volumes": [
        "<LAB_ROOT>/environment/aigoat-qualification-20261012-01/state/runtime-03/data:/app/data",
        "<LAB_ROOT>/environment/aigoat-qualification-20261012-01/config.json:/app/config/config.yml:ro",
        "<LAB_ROOT>/environment/aigoat-qualification-20261012-01/embedding:/models/embedding:ro"
      ]
    },
    "frontend": {
      "container_name": "dse-aigoat-20261012-frontend",
      "cpus": 0.5,
      "depends_on": {
        "backend": {
          "condition": "service_healthy"
        }
      },
      "image": "devsecops-electronics/aigoat-frontend:20261012-01",
      "labels": {
        "org.study.project": "devsecops-electronics",
        "org.study.role": "qualification",
        "org.study.target": "aigoat"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "128m",
      "memswap_limit": "128m",
      "networks": [
        "isolated"
      ],
      "pids_limit": 256,
      "restart": "no"
    },
    "ollama": {
      "container_name": "dse-aigoat-20261012-ollama",
      "cpus": 6,
      "environment": {
        "OLLAMA_CONTEXT_LENGTH": "4096",
        "OLLAMA_HOST": "0.0.0.0:11434",
        "OLLAMA_KEEP_ALIVE": "5m",
        "OLLAMA_MAX_LOADED_MODELS": "1",
        "OLLAMA_NUM_PARALLEL": "1"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 12,
        "test": [
          "CMD",
          "ollama",
          "list"
        ],
        "timeout": "5s"
      },
      "image": "devsecops-electronics/aigoat-ollama:20261012-01",
      "labels": {
        "org.study.project": "devsecops-electronics",
        "org.study.role": "qualification",
        "org.study.target": "aigoat"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "9g",
      "memswap_limit": "9g",
      "networks": [
        "isolated"
      ],
      "pids_limit": 256,
      "restart": "no",
      "volumes": [
        "<LAB_ROOT>/environment/aigoat-qualification-20261012-01/state/models:/root/.ollama"
      ]
    }
  }
}
